# The Game of Life — ncurses

CC = gcc
CFLAGS = -Wall -g -std=c11 -DNCURSES

SRC_DIR = src
BUILD_DIR = build

TARGET = $(BUILD_DIR)/gol

NCURSES_SOURCES = ncurses/ncurses.c \
				  ncurses/game.c
SOURCES = $(addprefix $(SRC_DIR)/,main.c gol.c $(NCURSES_SOURCES))
OBJECTS = $(SOURCES:.c=.o)

LDLIBS = -lncursesw

all: $(TARGET)

$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

$(TARGET): $(OBJECTS) | $(BUILD_DIR)
	$(CC) $(OBJECTS) $(LDLIBS) -o $@

$(SRC_DIR)/%.o: $(SRC_DIR)/%.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJECTS) $(TARGET)
	rmdir $(BUILD_DIR) 2>/dev/null || true

debug:
	@echo TARGET: $(TARGET)
	@echo OBJECTS: $(OBJECTS)
	@echo SOURCES: $(SOURCES)
	@echo CFLAGS: $(CFLAGS)
	@echo LDLIBS: $(LDLIBS)

.PHONY: all clean debug
