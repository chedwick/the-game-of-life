CompileFlags:
  Compiler: C:/msys64/mingw64/bin/gcc.exe
  Add:
    - --target=x86_64-w64-windows-gnu
    - -std=c11
    - -Wall
    - -g
    - -isystem
    - C:/msys64/mingw64/include

---
# Headers have no compile command of their own. clangd otherwise parses
# them as Objective-C++, which rejects -std=c11. This project is C only.
If:
  PathMatch: .*\.h$
CompileFlags:
  Add:
    - -xc-header
